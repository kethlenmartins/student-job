# Perfil dedicado à coleta — obrigatório para remote debugging funcionar
# NÃO aponte para ~/Library/Application Support/Google/Chrome
CHROME_USER_DATA_DIR=.chrome-debug
CHROME_PROFILE_DIRECTORY=Default

# Fluxo:
# 1. ./iniciar_chrome.sh
# 2. Login manual no Glassdoor (Continuar com Google) — só na 1ª vez
# 3. python coleta_glassdoor.py
CHROME_MODO=anexar
CHROME_DEBUG_PORT=9222
